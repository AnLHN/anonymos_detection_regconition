# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=7001
POSTGRES_DATABASE=face_db
POSTGRES_USER=face_user
POSTGRES_PASSWORD=change-me
POSTGRES_DSN=host=localhost port=7001 dbname=face_db user=face_user password=change-me

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=7002
QDRANT_URL=http://localhost:7002
QDRANT_COLLECTION=employee_faces
QDRANT_VECTOR_SIZE=512
QDRANT_DISTANCE=Cosine

# InsightFace
INSIGHTFACE_DEVICE=cuda
INSIGHTFACE_ROOT=./models/insightface
MODEL_ARTIFACTS_DIR=./models/artifacts
TRT_ENGINE_DIR=./models/trt
INSIGHTFACE_MODEL_PACK=buffalo_l
INSIGHTFACE_DETECTION_MODEL=buffalo_l
INSIGHTFACE_RECOGNITION_MODEL=buffalo_l
INSIGHTFACE_DET_SIZE=640
FACE_THRESHOLD=0.27
TRACK_DETECTION_SCORE=0.55
RECOGNITION_DETECTION_SCORE=0.85
TRACK_MIN_FACE_SIZE=40
RECOGNITION_MIN_FACE_SIZE=40
BEST_FACE_MIN_SIZE=60
# Legacy aliases kept for compatibility with older scripts.
MIN_DETECTION_SCORE=0.85
MIN_FACE_WIDTH=40
MIN_FACE_HEIGHT=40
TOP_K=5

# Runtime
UNKNOWN_STABLE_FRAMES=12
UNKNOWN_STABLE_SECONDS=1.5
KNOWN_STABLE_FRAMES=1
RECOGNITION_VOTE_WINDOW=5
KNOWN_MIN_VOTES=2
FACE_QUALITY_MIN_SCORE=0.25
UNKNOWN_REID_TTL_SECONDS=60
UNKNOWN_REID_THRESHOLD=0.35
UNKNOWN_ALERT_COOLDOWN_SECONDS=300
STREAM_PUBLISH_FPS=15
STREAM_JPEG_QUALITY=65
STREAM_FRAME_TTL_SECONDS=10
CAMERA_ZONE_RELOAD_INTERVAL_SECONDS=5
DEBUG_ANNOTATED_STREAM=false
TRACKER_TYPE=bytetrack
BYTETRACK_ACTIVATION_THRESHOLD=0.25
BYTETRACK_LOST_TRACK_BUFFER=30
BYTETRACK_MATCHING_THRESHOLD=0.8
BYTETRACK_MIN_CONSECUTIVE_FRAMES=1
TRACK_STATE_TTL_SECONDS=120
WORKING_HOUR_START=08:00
WORKING_HOUR_END=17:30
RESTRICTED_ZONES=restricted_area,server_room,warehouse
GATE_ZONES=gate
UNKNOWN_GATE_WARNING_FRAMES=12

# Backend
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_SUPER_PASSWORD=ntc123!@#
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_API_BASE=http://localhost/api
MJPEG_REDIS_POLL_INTERVAL=0.03
MJPEG_WAITING_FRAME_INTERVAL=1.0

# Reverse proxy / observability
NGINX_HTTP_PORT=80
REDIS_PORT=6379
RABBITMQ_DEFAULT_USER=face_user
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
PROMETHEUS_PORT=9090
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9093
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
REDIS_EXPORTER_PORT=9121
POSTGRES_EXPORTER_PORT=9187
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ALLOW_EMBEDDING=true
GRAFANA_AUTH_ANONYMOUS_ENABLED=true
GRAFANA_AUTH_ANONYMOUS_ORG_ROLE=Viewer
NEXT_PUBLIC_GRAFANA_DASHBOARD_URL=http://localhost:3001/d/unknown-detection-monitoring/unknown-detection-monitoring?kiosk

# MediaMTX WebRTC gateway
MEDIAMTX_PUBLIC_WEBRTC_BASE_URL=http://localhost:8889
MEDIAMTX_RTSP_TRANSPORT=tcp

